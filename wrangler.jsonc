// Top level = production (watchtogether.uk). `previews` = per-branch Worker Previews (Workers Builds runs `wrangler preview`).
// Previews don't inherit production bindings, so they are repeated there, pointed at preview-only resources.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchtogether",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "watchtogether.uk", "custom_domain": true }],
  // Production is never served on workers.dev; Previews are (<branch>-watchtogether.<account>.workers.dev).
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // "on" adds an always-live test episode to every show. Never on in production.
  "vars": { "DEMO_EPISODES": "off" },
  // Daily TVmaze sync at 05:00 UTC. Listings change rarely; overrides apply instantly on deploy.
  "triggers": { "crons": ["0 5 * * *"] },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // KV ids are auto-provisioned by wrangler on first deploy.
  "kv_namespaces": [{ "binding": "KV" }],
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_JOIN", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
  ],
  // Each Preview gets its own Durable Object namespace automatically (rooms never mix with production).
  // KV is one preview-only namespace shared by all Previews; it only holds the TVmaze cache and room codes.
  // No routes or crons here: Previews fill their schedule from TVmaze on first request.
  "previews": {
    // Every Preview has a live episode, so rooms can be tested whenever, not just while a show airs.
    "vars": { "DEMO_EPISODES": "on" },
    "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
    "kv_namespaces": [{ "binding": "KV" }],
    "ratelimits": [
      { "name": "RL_CREATE", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } },
      { "name": "RL_JOIN", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
    ],
  },
  "env": {
    // Local Playwright runs only (CLOUDFLARE_ENV=e2e). Never deployed: no routes, no workers.dev URL.
    // Same bindings, but higher rate limits because every test browser shares one IP.
    "e2e": {
      "name": "watchtogether-e2e",
      "routes": [],
      "vars": { "DEMO_EPISODES": "off" },
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
      "kv_namespaces": [{ "binding": "KV" }],
      "ratelimits": [
        { "name": "RL_CREATE", "namespace_id": "9001", "simple": { "limit": 100, "period": 60 } },
        { "name": "RL_JOIN", "namespace_id": "9002", "simple": { "limit": 200, "period": 60 } },
      ],
    },
  },
}
