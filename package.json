{
  "name": "watchtogether",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/worker && tsc -p test/worker && tsc -p test/unit && tsc -p test/e2e && tsc -p scripts",
    "lint": "eslint . --max-warnings 0 && prettier --check . && node scripts/check-unicode.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "seed:live": "node scripts/seed-live.mjs",
    "deploy:dry": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.1",
    "@vitest/coverage-istanbul": "~4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "obscenity": "^0.4.6",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  }
}
